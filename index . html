// ===== PERBAIKAN SCAN QR: pesan jelas + cadangan Foto/Galeri + ketik ID manual =====
async function qrDecodeCanvas(cv){
 if(window.BarcodeDetector){try{const d=new BarcodeDetector({formats:["qr_code"]});const r=await d.detect(cv);if(r[0]&&r[0].rawValue)return r[0].rawValue}catch(e){}}
 if(!window.jsQR){try{await ld("https://cdnjs.cloudflare.com/ajax/libs/jsqr/1.4.0/jsQR.min.js")}catch(e){return null}}
 try{const x=cv.getContext("2d",{willReadFrequently:true}),d=x.getImageData(0,0,cv.width,cv.height),r=window.jsQR&&jsQR(d.data,d.width,d.height);return r?r.data:""}catch(e){return ""}}
function qrDone(t){
 t=String(t||"").trim();if(t.startsWith("SMBL:"))t=t.slice(5);
 if(!SID.test(t))return false;
 $("m").classList.remove("on");sendReq(t);return true}
async function qrFile(inp){
 const f=inp.files&&inp.files[0];if(!f)return;toast("Membaca QR…");
 try{
  const bm=await createImageBitmap(f),sc=Math.min(1,1280/Math.max(bm.width,bm.height)),cv=document.createElement("canvas");
  cv.width=Math.round(bm.width*sc);cv.height=Math.round(bm.height*sc);cv.getContext("2d",{willReadFrequently:true}).drawImage(bm,0,0,cv.width,cv.height);
  const t=await qrDecodeCanvas(cv);
  if(t===null)return toast("Pembaca QR gagal dimuat (cek internet). Coba ketik ID temanmu.");
  if(!qrDone(t))toast("QR tidak terbaca / bukan QR ID Shadow. Coba foto lebih dekat dan terang.")
 }catch(e){toast("Foto tidak bisa dibaca. Coba ketik ID temanmu.")}
 inp.value=""}
function qrManual(){const v=($("qid").value||"").trim();if(!qrDone(v))toast("Format ID salah (contoh: Nama#1234)")}
async function qrScan(){
 modal(`<h3>📷 Scan QR ID</h3><video id="qv" playsinline muted style="display:none;width:100%;border-radius:8px;background:#000"></video>
 <div id="qmsg" class="pill" style="display:none;margin:6px 0;white-space:normal;line-height:1.4"></div>
 <button onclick="$('qf').click()" style="width:100%;margin:8px 0 6px">🖼️ Foto / Galeri QR</button>
 <input id="qf" type="file" accept="image/*" capture="environment" style="display:none" onchange="qrFile(this)">
 <div style="display:flex;gap:6px"><input id="qid" placeholder="Atau ketik ID teman (Nama#1234)" style="flex:1"><button onclick="qrManual()">Kirim</button></div>
 <small style="display:block;margin-top:6px;color:#ccc">Arahkan kamera ke QR ID temanmu, atau pakai foto / ketik ID.</small>`);
 const msg=t=>{const m=$("qmsg");if(m){m.style.display="block";m.textContent=t}};
 if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){
  return msg(window.isSecureContext===false?"Kamera diblokir karena game dibuka tanpa HTTPS (mis. dari file lokal). Pakai tombol Foto / Galeri atau ketik ID di bawah. Agar kamera langsung aktif, buka game lewat Chrome dengan alamat https://.":"Aplikasi tempat game dibuka tidak mengizinkan kamera langsung. Pakai tombol Foto / Galeri atau ketik ID di bawah, atau buka game lewat Chrome.")}
 let st;
 try{st=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:"environment"}}})}
 catch(e){try{st=await navigator.mediaDevices.getUserMedia({video:true})}catch(e2){
  const n=(e2&&e2.name)||"";
  return msg(n=="NotAllowedError"||n=="SecurityError"?"Izin kamera ditolak. Aktifkan lewat pengaturan situs/aplikasi: Izin → Kamera → Izinkan, lalu buka Scan lagi. Sementara itu pakai Foto / Galeri atau ketik ID.":n=="NotFoundError"||n=="OverconstrainedError"?"Kamera tidak ditemukan di perangkat ini. Pakai Foto / Galeri atau ketik ID.":"Kamera tidak bisa dibuka ("+n+"). Pakai Foto / Galeri atau ketik ID.")}}
 const v=$("qv");if(!v){st.getTracks().forEach(t=>t.stop());return}
 const stop2=()=>st.getTracks().forEach(t=>t.stop());
 v.style.display="block";v.srcObject=st;try{await v.play()}catch(e){}
 const cv=document.createElement("canvas");let busy=0;
 const tick=async()=>{
  if(!document.body.contains(v)||!$("m").classList.contains("on"))return stop2();
  if(!busy&&v.videoWidth){busy=1;try{const sc=Math.min(1,720/v.videoWidth);cv.width=Math.round(v.videoWidth*sc);cv.height=Math.round(v.videoHeight*sc);cv.getContext("2d",{willReadFrequently:true}).drawImage(v,0,0,cv.width,cv.height);
   const t=await qrDecodeCanvas(cv);
   if(t===null){stop2();v.style.display="none";return msg("Pembaca QR gagal dimuat (cek internet). Pakai Foto / Galeri atau ketik ID.")}
   if(t&&qrDone(t)){stop2();return}}catch(e){}busy=0}
  setTimeout(tick,300)};
 tick()}

